{
  "schema_version": 1,
  "plugin": "tj-agents/agent",
  "source_roots": [
    ".agents/agent"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/agent",
      "tj-agents/base",
      "tj-agents/agent-store",
      "tj-agents/cli"
    ],
    "hooks": [
      {
        "path": ".agents/agent/runtime/session_hook.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [],
      "codex_prefix_rules": []
    }
  }
}
