{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "8",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent/utility/peer/scripts/register_session.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 15,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "12",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent-store/runtime/session_hook.py",
              "prompt",
              "--host",
              "claude",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/close_lifecycle.py",
              "prompt",
              "--host",
              "claude"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 60,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "55",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent-store/runtime/session_hook.py",
              "stop",
              "--host",
              "claude",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/close_lifecycle.py",
              "stop",
              "--host",
              "claude"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 10,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent-store/runtime/session_hook.py",
              "session-end",
              "--host",
              "claude"
            ]
          }
        ]
      }
    ]
  }
}
