{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" start --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" start --host codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" prompt --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" prompt --host codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" end --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" end --host codex"
          }
        ]
      }
    ]
  }
}
