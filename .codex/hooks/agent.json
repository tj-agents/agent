{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 360,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" start --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" start --host codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "preserveDescendants": true,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/observer_start.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/observer_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "timeout": 30, "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py\" --host codex --hook-mode prompt", "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py\" --host codex --hook-mode prompt"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "timeout": 5, "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py\" --host codex", "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py\" --host codex"}]
      }
    ],
    "Interrupt": [
      {
        "hooks": [{"type": "command", "timeout": 3, "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py\" --host codex", "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py\" --host codex"}]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" end --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py\" end --host codex"
          }
        ]
      }
    ]
  }
}
