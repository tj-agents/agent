      "tj-agents/cli"
    ],
    "codex": [
      "agent"
    ]
  },
  "resources": [
    {
      "plugin": "agent-store",
      "distribution": "tj-agent-store",
      "destination": "python"
    },
    {
      "plugin": "agent",
      "distribution": "tj-agent-store",
      "destination": "python"
    },
    {
      "plugin": "agent",
      "distribution": "tj-agent",
      "destination": "python"
    },
    {
      "plugin": "agent",
      "distribution": "tj-cli",
      "destination": "python"
