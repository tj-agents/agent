      "destination": "hooks/hook_dispatch.py"
    },
    {
      "plugin": "agent",
      "source": ".claude/hooks/agent.json",
      "destination": "hooks/claude.json"
    },
    {
      "plugin": "agent",
      "source": ".codex/hooks/agent.json",
      "destination": "hooks/codex.json"
    },
    {
      "plugin": "codex",
      "distribution": "tj-agent",
      "destination": "python"
    },
    {
      "plugin": "codex",
      "distribution": "tj-agent-store",
      "destination": "python"
    },
    {
      "plugin": "codex",
      "distribution": "tj-cli",
      "destination": "python"
    },
    {
      "plugin": "agent",
      "source": ".agents/hooks/install.py",
      "destination": "hooks/install.py"
    },
    {
      "plugin": "agent",
      "source": ".agents/hooks/session_store.py",
      "destination": "hooks/session_store.py"
    },
    {
      "plugin": "agent",
      "source": ".agents/hooks/close_lifecycle.py",
      "destination": "hooks/close_lifecycle.py"
    },
    {
      "plugin": "agent",
      "source": ".agents/hooks/startup_binding.py",
      "destination": "hooks/startup_binding.py"
