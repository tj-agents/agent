{
  "payloads": {
    "agent-store": ["agent-store"],
    "agent": ["agent"],
    "codex": ["codex"]
  },
  "dependencies": {
    "agent": ["tj-agents/base", "agent-store", "tj-agents/cli"],
    "codex": ["agent"]
  },
  "resources": [
    {"plugin": "agent-store", "source": ".agents/agent-store/runtime", "destination": ".agents/agent-store/runtime"},
    {"plugin": "agent", "source": ".agents/agent-store/runtime", "destination": ".agents/agent-store/runtime"},
    {"plugin": "agent", "source": ".agents/agent/runtime", "destination": ".agents/agent/runtime"},
    {"plugin": "agent", "source": ".claude/runtime", "destination": ".agents/agent/runtime/claude"},
    {"plugin": "agent", "source": ".codex/runtime", "destination": ".agents/agent/runtime/codex"},
    {"plugin": "agent", "source": ".agents/agent/resources", "destination": ".agents/agent/resources"},
    {"plugin": "agent", "source": ".agents/hooks/hook_dispatch.py", "destination": "hooks/hook_dispatch.py"},
    {"plugin": "agent", "source": ".claude/hooks/agent.json", "destination": "hooks/claude.json"},
    {"plugin": "agent", "source": ".codex/hooks/agent.json", "destination": "hooks/codex.json"}
  ],
  "host_adapters": [
    {"skill": "agent:listen", "host": "codex", "source": ".agents/plugins/adapters/codex/agent/listen.md"},
    {"skill": "agent:listen", "host": "claude", "source": ".agents/plugins/adapters/claude/agent/listen.md"},
    {"skill": "agent:refresh-plugins", "host": "codex", "source": ".agents/plugins/adapters/codex/agent/refresh-plugins.md"},
    {"skill": "agent:refresh-plugins", "host": "claude", "source": ".agents/plugins/adapters/claude/agent/refresh-plugins.md"},
    {"skill": "agent:message", "host": "codex", "source": ".agents/plugins/adapters/codex/agent/message.md"},
    {"skill": "agent:message", "host": "claude", "source": ".agents/plugins/adapters/claude/agent/message.md"},
    {"skill": "agent:peer", "host": "codex", "source": ".agents/plugins/adapters/codex/agent/peer.md"},
    {"skill": "agent:peer", "host": "claude", "source": ".agents/plugins/adapters/claude/agent/peer.md"}
  ]
}

