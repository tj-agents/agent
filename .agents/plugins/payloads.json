{
  "payloads": {
    "agent-store": ["agent-store"],
    "agent": ["agent"],
    "codex": ["codex"],
    "claude": ["claude"]
  },
  "dependencies": {
    "agent": ["tj-agents/base", "agent-store"],
    "codex": ["agent"],
    "claude": ["agent"]
  },
  "resources": [
    {"plugin": "agent-store", "source": ".agents/agent-store/runtime", "destination": ".agents/agent-store/runtime"},
    {"plugin": "agent", "source": ".agents/agent-store/runtime", "destination": ".agents/agent-store/runtime"},
    {"plugin": "codex", "source": ".agents/agent-store/runtime", "destination": ".agents/agent-store/runtime"},
    {"plugin": "claude", "source": ".agents/agent-store/runtime", "destination": ".agents/agent-store/runtime"},
    {"plugin": "agent", "source": ".agents/agent/runtime", "destination": ".agents/agent/runtime"},
    {"plugin": "codex", "source": ".agents/agent/runtime", "destination": ".agents/agent/runtime"},
    {"plugin": "claude", "source": ".agents/agent/runtime", "destination": ".agents/agent/runtime"},
    {"plugin": "agent", "source": ".agents/agent/resources", "destination": ".agents/agent/resources"},
    {"plugin": "codex", "source": ".agents/agent/resources", "destination": ".agents/agent/resources"},
    {"plugin": "claude", "source": ".agents/agent/resources", "destination": ".agents/agent/resources"},
    {"plugin": "codex", "source": ".agents/agent/utility/peer/scripts", "destination": ".agents/agent/utility/peer/scripts"},
    {"plugin": "claude", "source": ".agents/agent/utility/peer/scripts", "destination": ".agents/agent/utility/peer/scripts"},
    {"plugin": "codex", "source": ".agents/agent/utility/plugins/scripts", "destination": ".agents/agent/utility/plugins/scripts"},
    {"plugin": "claude", "source": ".agents/agent/utility/plugins/scripts", "destination": ".agents/agent/utility/plugins/scripts"}
  ],
  "host_adapters": [
    {"skill": "agent:listen", "host": "codex", "source": ".agents/plugins/adapters/codex/agent/listen.md"},
    {"skill": "agent:listen", "host": "claude", "source": ".agents/plugins/adapters/claude/agent/listen.md"},
    {"skill": "agent:refresh", "host": "codex", "source": ".agents/plugins/adapters/codex/agent/refresh.md"},
    {"skill": "agent:refresh", "host": "claude", "source": ".agents/plugins/adapters/claude/agent/refresh.md"}
  ]
}
