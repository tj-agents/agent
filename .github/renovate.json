{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tj-agents/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The agent-store release Agent installs",
      "managerFilePatterns": [
        "/^\\.agents/agent/runtime/agent-store\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tj-agents/agent-store"
    },
    {
      "customType": "regex",
      "description": "The tj-work-items CLI and work-item profile packages Agent installs",
      "managerFilePatterns": [
        "/^\\.agents/agent/runtime/work-items\\.json$/"
      ],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>[^\"]+)\",\\s*\"subdirectory\":\\s*\"[^\"]+\",\\s*\"revision\":\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "The native TJ CLI release required for safe session resume",
      "managerFilePatterns": [
        "/^\\.agents/agent/runtime/native_runtime\\.py$/"
      ],
      "matchStrings": [
        "NATIVE_REVISION = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/tj-agents/cli",
      "currentValueTemplate": "main"
    }
  ]
}
