{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "The agent-store release Agent installs",
      "managerFilePatterns": [
        "/^\\.agents/agent/runtime/agent-store\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tj-agents/agent-store"
    }
  ]
}
