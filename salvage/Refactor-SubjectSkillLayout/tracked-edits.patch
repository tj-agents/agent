-        if value:
-            parts.append(name + "=" + " ".join(str(value).split()))
-    detail = "; ".join(parts)
-    if len(detail) > SCHEDULER_DIAGNOSTIC_LIMIT:
-        detail = detail[:SCHEDULER_DIAGNOSTIC_LIMIT] + "..."
