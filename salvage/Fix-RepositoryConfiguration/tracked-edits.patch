+$generatedRoot = Join-Path $PSScriptRoot 'plugins'
+$generatedRoot = Join-Path $generatedRoot 'agent'
+$generatedRoot = Join-Path $generatedRoot '.agents'
+$generatedRoot = Join-Path $generatedRoot 'agent'
