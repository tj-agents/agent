+            resolved.add(identity)
+            name, _, marketplace = identity.partition("@")
+            pending.extend(
+                f"{dependency}@{marketplace}"
+                for dependency in dependencies.get(name, ())
+            )
+        return {identity: dict(EMPTY) for identity in resolved}
+
+    return declarations
