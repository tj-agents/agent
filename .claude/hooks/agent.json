{
  "modules": ["../.agents/agent/runtime/claude/message_bridge.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py",
              "start",
              "--host",
              "claude"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "timeout": 5, "onFailure": "block", "command": "python", "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py", "--host", "claude"]}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "timeout": 5, "command": "python", "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py", "--host", "claude"]}]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{"type": "command", "timeout": 5, "command": "python", "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/completion_hook.py", "--host", "claude"]}]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/agent/runtime/session_hook.py",
              "end",
              "--host",
              "claude"
            ]
          }
        ]
      }
    ]
  }
}
